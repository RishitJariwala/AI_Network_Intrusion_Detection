# Copy to .env and fill in. Never commit .env.

# Database: SQLite for development, PostgreSQL optional.
DATABASE_URL=sqlite:///./data/nids.db
# DATABASE_URL=postgresql+psycopg2://nids_user:change_me@localhost:5432/nids

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Optional Cyber Threat Intelligence keys. Leave blank to run fully offline.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=

# Upload safety limit for the dashboard / API (megabytes)
MAX_UPLOAD_MB=50
